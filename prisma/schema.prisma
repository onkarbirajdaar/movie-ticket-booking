generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model City {
  id       String  @id @default(uuid())
  name     String
  isActive Boolean @default(true)
  theatres Theatre[]
}
model Theatre {
  id      String @id @default(uuid())
  name    String
  address String
  cityId  String          
  city    City   @relation(fields: [cityId], references: [id])   
  screens Screen[]
  amenities String?
  isActive Boolean @default(true)
}
model Screen {
  id      String @id @default(uuid())
  name    String
  format  String
  totalSeats Int
  theatreId String
  theatre   Theatre @relation(fields: [theatreId], references: [id])
  seats Seat[]
  shows Show[]
}
model Seat{
  id String @id @default(uuid())
  screenId String
  screen Screen @relation(fields: [screenId], references: [id])

  rowLabel String
  seatNumber Int
  section String
  seatType String
  isActive Boolean @default(true)
  isAccessible Boolean @default(false)
  @@unique([screenId, rowLabel, seatNumber])
  showSeats ShowSeat[]

}
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  phone        String?
  createdAt    DateTime @default(now())
}

model Movie {
  id              String  @id @default(uuid())
  title           String
  synopsis        String?
  durationMinutes Int
  language        String
  posterUrl       String?
  status          String
  shows Show[]
}

enum Role {
  CUSTOMER
  ADMIN
}

model Show{
  id String @id @default(uuid())
  movieId String
  movie Movie @relation(fields: [movieId], references: [id])
  screenId String
  screen Screen @relation(fields: [screenId], references: [id])
  startsAt DateTime
  endsAt DateTime
  format String
  language String
  status String
  showSeats ShowSeat[]
}

model ShowSeat{
  id String @id @default(uuid())
  showId String
  show Show @relation(fields: [showId], references: [id])
  seatId String
  seat Seat @relation(fields: [seatId], references: [id])
  price Float
  status String
  holdExpiresAt DateTime?
  @@unique([showId, seatId])
}