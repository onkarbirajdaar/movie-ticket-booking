generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model City {
  id       String  @id @default(uuid())
  name     String
  isActive Boolean @default(true)
  theatres Theatre[]
}
model Theatre {
  id      String @id @default(uuid())
  name    String
  address String
  cityId  String          
  city    City   @relation(fields: [cityId], references: [id])   
  screens Screen[]
  amenities String?
  isActive Boolean @default(true)
}
model Screen {
  id      String @id @default(uuid())
  name    String
  format  String
  totalSeats Int
  theatreId String
  theatre   Theatre @relation(fields: [theatreId], references: [id])
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  phone        String?
  createdAt    DateTime @default(now())
}

model Movie {
  id              String  @id @default(uuid())
  title           String
  synopsis        String?
  durationMinutes Int
  language        String
  posterUrl       String?
  status          String
}

enum Role {
  CUSTOMER
  ADMIN
}
